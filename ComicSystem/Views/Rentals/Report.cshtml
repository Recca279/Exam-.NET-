@model IEnumerable<ComicSystem.Controllers.ReportViewModel>

@{
    ViewData["Title"] = "Rental Report";
}

<h1>Rental Report</h1>

<form method="get" asp-action="Report" class="form-inline mb-3">
    <div class="row align-items-end">
        <div class="col-auto">
            <label for="startDate">Start Date</label>
            <input type="date" id="startDate" name="startDate" class="form-control" value="@ViewBag.StartDate" />
        </div>
        <div class="col-auto">
            <label for="endDate">End Date</label>
            <input type="date" id="endDate" name="endDate" class="form-control" value="@ViewBag.EndDate" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="Report" class="btn btn-secondary">Clear</a>
        </div>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>No</th>
            <th>Book name</th>
            <th>Rental date</th>
            <th>Return date</th>
            <th>Customer name</th>
            <th>Quantity</th>
        </tr>
    </thead>
    <tbody>
        @{
            int no = 1;
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@no</td>
                <td>@item.BookName</td>
                <td>@item.RentalDate.ToString("MM/dd/yyyy")</td>
                <td>@item.ReturnDate.ToString("MM/dd/yyyy")</td>
                <td>@item.CustomerName</td>
                <td>@item.Quantity</td>
            </tr>
            no++;
        }
        @if(!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center">No records found.</td>
            </tr>
        }
    </tbody>
</table>
